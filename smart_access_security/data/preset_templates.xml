<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Preset 1: Sales Representative Restricted Profile -->
        <record id="preset_sales_restricted_profile" model="access.management">
            <field name="name">Sales Representative Security &amp; Privacy Profile</field>
            <field name="user_ids" search="[('login', 'in', ['demo', 'portal'])]"/>
            <field name="readonly_user">False</field>
            <field name="disable_debug">True</field>
            <field name="disable_api_access">True</field>
            <field name="description">Enforces strict role-based access control for sales staff: blocks developer mode (?debug=1), restricts external API access, hides financial menus, and locks customer data export.</field>
            <field name="sequence">1</field>
        </record>

        <!-- Model Access Rule 1: Sale Order Restriction -->
        <record id="rule_sale_order_model" model="access.model">
            <field name="access_management_id" ref="preset_sales_restricted_profile"/>
            <field name="model_id" search="[('model', '=', 'sale.order')]"/>
            <field name="perm_read">True</field>
            <field name="perm_create">True</field>
            <field name="perm_write">True</field>
            <field name="perm_unlink">False</field>
            <field name="perm_export">False</field>
            <field name="perm_archive">False</field>
            <field name="hide_pivot">True</field>
            <field name="hide_graph">True</field>
        </record>

        <!-- Model Access Rule 2: Customer Contact Restriction -->
        <record id="rule_partner_model" model="access.model">
            <field name="access_management_id" ref="preset_sales_restricted_profile"/>
            <field name="model_id" search="[('model', '=', 'res.partner')]"/>
            <field name="perm_read">True</field>
            <field name="perm_create">True</field>
            <field name="perm_write">True</field>
            <field name="perm_unlink">False</field>
            <field name="perm_export">False</field>
            <field name="perm_import">False</field>
        </record>

        <!-- Preset 2: Global Read-Only Audit Profile -->
        <record id="preset_readonly_profile" model="access.management">
            <field name="name">Global System Auditor (Read-Only Mode)</field>
            <field name="readonly_user">True</field>
            <field name="disable_debug">True</field>
            <field name="disable_app_install">True</field>
            <field name="description">Master threat prevention profile for external auditors and guest users. Enforces system-wide read-only access across all models.</field>
            <field name="sequence">2</field>
        </record>
    </data>
</odoo>
